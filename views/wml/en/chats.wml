<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE wml PUBLIC "-//WAPFORUM//DTD WML 1.1//EN"
    "http://www.wapforum.org/DTD/wml_1.1.xml">
<wml>
    <card id="chat" title="SuperBasic IM">
        <p>
            {{#if chat_unreadMessages}}
                <a href="/chats/{{chat_id}}/seen">
                    Mark all messages as read
                </a><br/>
            {{/if}}

            {{#if groupChat}}
                <a href="/chats/{{chat_id}}/info">
                    Group information
                </a><br/>
            {{else}}
                <a href="/chats/{{chat_id}}/vcard">
                    Download vCard
                </a><br/>
            {{/if}}

            {{#if chat_tooManyUnreadMessages}}
                <a href="/chats/{{chat_id}}/allunreadmessages">
                    Show {{amountUnreadMessages}} unread messages
                </a><br/>
            {{/if}}
        </p>

        {{#each messages}}
            <p>
                {{#if this.fromMe}}
                    <b>Me</b>
                {{else}}
                    <b>{{this.from}}</b>
                {{/if}}

                {{#if this.time}}
                    ({{this.time}})
                {{/if}}

                <br/>

                {{#each this.msg}}
                    {{this}}<br/>
                {{/each}}

                {{#if this.media}}
                    <a href="/media/{{this.id}}">
                        Download attachment
                    </a><br/>
                {{/if}}

                {{#if this.hasQuotedMessage}}
                    Replies to:<br/>
                    {{this.repliedMessage}}<br/>
                {{/if}}

                {{#if this.hasReaction}}
                    Reactions:<br/>
                    {{#each this.reactionsDetails}}
                        {{this}}<br/>
                    {{/each}}
                {{/if}}
            </p>
        {{/each}}

        <p>
            Message:<br/>
            <input
                type="text"
                name="message"
                value=""
                size="30"
            />
            <br/>

            <anchor>
                Send
                <go
                    href="/chats/{{chat_id}}/reply"
                    method="post"
                >
                    <postfield
                        name="crumb"
                        value="{{crumb}}"
                    />
                    <postfield
                        name="message"
                        value="$(message)"
                    />
                </go>
            </anchor>
        </p>

        <p>
            <a href="/chats/{{chat_id}}">Refresh</a><br/>
            <a href="/recentchats">Recent chats</a><br/>
            <a href="/">Home</a>
        </p>
    </card>
</wml>
